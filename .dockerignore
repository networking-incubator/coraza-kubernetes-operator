# Ignore everything by default
**
**/*

# Re-include directories that contain code
!cmd/
!api/
!internal/
!pkg/
!internal/

# Re-include Go source and module files
!*.go
!**/*.go
!go.mod
!go.sum

# Re-include the embedded WASM bundle (go:embed in internal/assets)
!internal/assets/
!internal/assets/**

# Ignore test files
**/*_test.go