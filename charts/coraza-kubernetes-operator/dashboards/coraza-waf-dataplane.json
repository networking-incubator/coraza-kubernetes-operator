{
  "uid": "coraza-waf-dataplane",
  "title": "Coraza WAF — Dataplane",
  "tags": [
    "coraza",
    "operator",
    "dataplane",
    "waf"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "version": 2,
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "",
      "transparent": false,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Live **coraza_waf_*** metrics from Envoy Gateway pods (Proxy-WASM contract mode). Select the Engine namespace and name from the dropdowns (e.g. `integration-tests` / `coraza` for the demo, `crs-conformance-*` / `conformance-engine` during FTW)."
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Traffic summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "panels": []
    },
    {
      "type": "stat",
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(coraza_waf_requests_total{namespace=~\"$namespace\", engine=~\"$engine\"}[5m]))",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "description": "All WAF-inspected requests per second.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(coraza_waf_requests_total{namespace=~\"$namespace\", engine=~\"$engine\", outcome=\"block\"}[5m]))",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Block rate",
      "description": "Blocked requests per second (outcome=block).",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "yellow"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(coraza_waf_requests_total{namespace=~\"$namespace\", engine=~\"$engine\", outcome=\"block\"}[5m])) / sum(rate(coraza_waf_requests_total{namespace=~\"$namespace\", engine=~\"$engine\"}[5m]))) and sum(rate(coraza_waf_requests_total{namespace=~\"$namespace\", engine=~\"$engine\"}[5m])) \u003e 0",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Block ratio",
      "description": "Share of requests blocked in the selected window. No data when there is no traffic.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.05,
                "color": "yellow"
              },
              {
                "value": 0.2,
                "color": "red"
