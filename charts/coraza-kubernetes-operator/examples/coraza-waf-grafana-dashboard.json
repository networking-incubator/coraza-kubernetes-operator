          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "Blocked volume by category and severity together. Uses a one hour increase (or the raw counter if increase is empty) so rare events still show up in the table."
