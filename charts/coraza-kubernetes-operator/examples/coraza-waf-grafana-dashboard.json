  "panels": [
    {
      "id": 40,
      "type": "row",
      "title": "OTC \u2014 WASM Plugin & Envoy Health (active)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "description": "Metrics actively flowing from the OTC sidecar (job=coraza-envoy). Source: Envoy admin stats scraped at 127.0.0.1:15090/stats/prometheus and re-exported via OTC prometheus exporter on :9090."
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "WASM plugin reload rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate({__name__=~\"envoy_wasm_.*_vm_reload_success_total\", job=\"coraza-envoy\"}[5m]))",
          "legendFormat": "success",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate({__name__=~\"envoy_wasm_.*_vm_reload_failure_total\", job=\"coraza-envoy\"}[5m]))",
          "legendFormat": "failure",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate({__name__=~\"envoy_wasm_.*_vm_reload_backoff_total\", job=\"coraza-envoy\"}[5m]))",
          "legendFormat": "backoff",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "description": "Rate of Coraza WASM plugin VM reloads (success / failure / backoff). A sustained failure rate means the WASM binary or cache-server token is unhealthy."
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "WASM remote-load cache",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(envoy_wasm_remote_load_cache_hits_total{job=\"coraza-envoy\"}[5m])",
          "legendFormat": "cache hits",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(envoy_wasm_remote_load_cache_misses_total{job=\"coraza-envoy\"}[5m])",
          "legendFormat": "cache misses",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(envoy_wasm_remote_load_fetch_failures_total{job=\"coraza-envoy\"}[5m])",
          "legendFormat": "fetch failures",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "description": "Envoy WASM binary remote-load cache activity. Misses trigger a fetch from the OCI registry; fetch failures indicate an unreachable OCI source. High miss + fetch-failure rate means the WASM binary can not be refreshed."
    },
