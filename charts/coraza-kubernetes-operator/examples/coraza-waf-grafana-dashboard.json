          "editorMode": "code",
          "expr": "sum(rate(coraza_waf_requests_total[5m])) or vector(0)",
          "legendFormat": "__",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "All Coraza requests per second (pass and block combined) over the last 5 minutes. Shows zero when nothing is moving."
