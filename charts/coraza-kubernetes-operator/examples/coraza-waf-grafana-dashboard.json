      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (category, severity) (increase(coraza_waf_blocked_requests_total[1h])) or sum by (category, severity) (coraza_waf_blocked_requests_total)",
