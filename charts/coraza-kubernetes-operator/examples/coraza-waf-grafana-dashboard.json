  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Request overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "description": "High level request volume and how much of it is blocked."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(coraza_waf_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "Request rate split by outcome (pass vs block) over a 5 minute window. Use this to see whether traffic is mostly allowed or rejected."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Block ratio (1h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(coraza_waf_requests_total{outcome=\"block\"}[1h])) / clamp_min(sum(increase(coraza_waf_requests_total[1h])), 1e-9)",
          "legendFormat": "__",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "Share of requests that were blocked in the last hour (blocked divided by total). Sparse traffic makes a 5 minute rate look stuck at zero, so this uses a one hour increase."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total throughput",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "red",
                "value": null
