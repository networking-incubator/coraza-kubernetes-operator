        "label": "Engine",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({__name__=~\"coraza_waf_.*\"}, engine)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "hide": 0,
        "definition": "label_values({__name__=~\"coraza_waf_.*\"}, engine)"
      },
      {
        "name": "gateway",
        "type": "query",
        "label": "Gateway",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({__name__=~\"coraza_waf_.*\"}, gateway)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "hide": 0,
        "definition": "label_values({__name__=~\"coraza_waf_.*\"}, gateway)"
      },
