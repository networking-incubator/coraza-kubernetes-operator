# form-urlencoded - POST application/x-www-form-urlencoded.
# Coraza parses urlencoded bodies INTO the ARGS collection, so this hits the
# 165 ARGS rules via the body path plus the phase-2 body machinery.
METHOD="POST"
REQ_PATH="/submit"
CONTENT_TYPE="application/x-www-form-urlencoded"
PAYLOAD_FILE="/payloads/form-urlencoded.txt"
PAYLOAD_SIZE="0"
