# args-heavy - GET with 25 query args.
# CRS evaluates most detection rules once PER ARGUMENT, so this multiplies
# phase-2 work ~25x vs baseline-get. Highest-leverage profile for CRS cost.
METHOD=""
REQ_PATH="/search?q=shoes&page=2&sort=price&order=desc&lang=en&currency=usd&size=42&color=blue&brand=acme&min=10&max=500&instock=1&rating=4&ship=free&cat=footwear&sub=running&gender=u&width=d&material=mesh&season=ss26&promo=none&ref=homepage&sid=abc123&utm_source=email&utm_campaign=spring"
PAYLOAD_SIZE="0"
