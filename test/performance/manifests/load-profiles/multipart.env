# multipart - POST multipart/form-data.
# The only profile that exercises CRS's 922 multipart family and the
# MULTIPART_STRICT_ERROR check in base-rules.
# NOTE: payload is generated (needs strict CRLF) - run ./gen-payloads.sh.
METHOD="POST"
REQ_PATH="/upload"
CONTENT_TYPE="multipart/form-data; boundary=----perfboundary"
PAYLOAD_FILE="/payloads/multipart.bin"
PAYLOAD_SIZE="0"
