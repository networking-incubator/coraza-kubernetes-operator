# headers-heavy - GET / with 15 extra request headers.
# Exercises the phase-1 REQUEST_HEADERS rules against a realistic header set.
METHOD=""
REQ_PATH="/"
PAYLOAD_SIZE="0"
HEADERS=(
  "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
  "Accept-Language: en-US,en;q=0.9,de;q=0.8"
  "Accept-Encoding: gzip, deflate, br"
  "Cache-Control: no-cache"
  "Pragma: no-cache"
  "Referer: https://example.com/catalog"
  "Origin: https://example.com"
  "X-Requested-With: XMLHttpRequest"
  "X-Forwarded-For: 203.0.113.7"
  "X-Request-Id: 4f1c2b9a-7d3e-4a21-9f84-0b6c5d2e1a77"
  "Cookie: sid=abc123; prefs=dark; cart=7"
  "DNT: 1"
  "Sec-Fetch-Site: same-origin"
  "Sec-Fetch-Mode: cors"
  "Upgrade-Insecure-Requests: 1"
)
