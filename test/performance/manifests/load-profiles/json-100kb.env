# json-100kb - POST application/json, ~100 KB realistic body.
# Body-size scaling for the JSON parse + body-rule path. Lower QPS is wise;
# pair with scenarios/low-rate-200qps.env.
# NOTE: payload is generated - run ./gen-payloads.sh (setup.sh does this).
METHOD="POST"
REQ_PATH="/api/bulk"
CONTENT_TYPE="application/json"
PAYLOAD_FILE="/payloads/json-100kb.json"
PAYLOAD_SIZE="0"
