# attack-keyword - GET with the literal "attack" keyword in an argument.
# Replaces the old scenarios/attack-block.env.
#
# Ruleset-specific: minimal and medium both carry a rule that denies on
# "@contains attack", so this returns 403 there. CRS has no such rule and
# returns 200 - use attack-sqli for CRS instead.
METHOD=""
REQ_PATH="/?q=attack"
PAYLOAD_SIZE="0"
EXPECT_STATUS="403"
