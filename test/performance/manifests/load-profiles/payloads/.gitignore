# Hand-written payloads here ARE committed; the repo-root .gitignore has a
# blanket *.txt rule that would silently drop form-urlencoded.txt and break
# that profile on a fresh clone.
!*.txt

# Generated by ../gen-payloads.sh - not committed.
# multipart needs strict CRLF that editors and git mangle; the 100 KB JSON
# blob does not belong in version control. Both are deterministic.
multipart.bin
json-100kb.json
