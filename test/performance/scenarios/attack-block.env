# Blocking path: 100% malicious traffic (query contains "attack"). With the WAF
# on this returns 403 and short-circuits the backend; run with EXPECT_BLOCK=true.
# With the WAF off it is a normal 200 (use EXPECT_BLOCK=false for the baseline).
QPS="500"
DURATION="120s"
CONNS="16"
REQ_PATH="/?q=attack"
PAYLOAD_SIZE="0"
